{
  "packageFormat": "2.0",
  "id": "simple-web-form",
  "name": "简单网页表单",
  "description": "虚构数据验收模板；不含用户资料或密钥",
  "version": "1.0.0",
  "author": "FlowArk Templates",
  "source": "https://github.com/zhongmiao-org/flow-ark-templates",
  "minimumClientVersion": "0.2.0",
  "sdkVersion": "1.0",
  "configurationSchema": "schemas/configuration.json",
  "stateSchema": "schemas/state.json",
  "resources": [
    {
      "id": "browser",
      "name": "浏览器",
      "kind": "browser",
      "access": "use",
      "required": true
    }
  ],
  "actions": [
    {
      "id": "form-write",
      "name": "提交虚构表单",
      "description": "向配置网页写入虚构测试数据",
      "default": "deny"
    }
  ],
  "dependencies": [],
  "entries": [
    {
      "id": "run",
      "name": "填写简单表单",
      "flow": "flows/run.json",
      "inputSchema": "schemas/input.json",
      "resultSchema": "schemas/result.json",
      "schedulable": false,
      "capabilities": [
        "browser",
        "excel",
        "condition",
        "assert"
      ],
      "resources": [
        "browser"
      ],
      "actions": [
        "form-write"
      ]
    }
  ],
  "build": {}
}