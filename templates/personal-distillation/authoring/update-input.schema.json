{
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "requirements", "fragment", "factNumber", "round"],
  "properties": {
    "scope": {
      "type": "string",
      "title": "要修改的项目",
      "enum": ["目标岗位", "期望地点", "工作形式", "期望薪资", "排除方向", "真实表达样例", "表达规则", "待确认表达推断", "允许自动回复", "需要本人处理", "禁止自动回复", "待补问题", "矛盾记录", "事实内容", "事实来源说明", "事实状态", "新增事实", "删除指定事实", "仅正文片段"],
      "default": "期望薪资",
      "description": "每次只修改明确选择的一项，其余手工内容保留。"
    },
    "requirements": {
      "type": "string",
      "title": "更新要求",
      "minLength": 1,
      "maxLength": 16000,
      "description": "说明具体修改及依据；缺少信息时先补充访谈。"
    },
    "fragment": {
      "type": "string",
      "title": "正文同步更新片段",
      "maxLength": 60000,
      "default": "",
      "description": "粘贴父版本中准确且唯一的原文；留空表示正文没有对应内容，此时正文保持。"
    },
    "factNumber": {
      "type": "integer",
      "title": "事实序号（仅事实类更新使用）",
      "minimum": 1,
      "maximum": 1000,
      "default": 1
    },
    "round": {
      "type": "string",
      "title": "访谈标识",
      "minLength": 1,
      "maxLength": 100,
      "default": "update-1",
      "description": "保持相同父版本、要求和标识继续本次访谈；需要重新访谈时改用新标识。"
    }
  }
}
