{
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "markdown", "profile"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "markdown": { "type": "string", "minLength": 1, "maxLength": 60000 },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts", "preferences", "expression", "boundaries", "unknown", "conflicts"],
      "properties": {
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["statement", "source", "status"],
            "properties": {
              "statement": { "type": "string" },
              "source": { "type": "string" },
              "status": { "type": "string", "enum": ["reported", "unknown", "conflict"] }
            }
          }
        },
        "preferences": {
          "type": "object",
          "additionalProperties": false,
          "required": ["roles", "locations", "workModes", "salary", "exclusions"],
          "properties": {
            "roles": { "type": "array", "items": { "type": "string" } },
            "locations": { "type": "array", "items": { "type": "string" } },
            "workModes": { "type": "array", "items": { "type": "string" } },
            "salary": { "type": "string" },
            "exclusions": { "type": "array", "items": { "type": "string" } }
          }
        },
        "expression": {
          "type": "object",
          "additionalProperties": false,
          "required": ["examples", "rules", "inferred"],
          "properties": {
            "examples": { "type": "array", "items": { "type": "string" } },
            "rules": { "type": "array", "items": { "type": "string" } },
            "inferred": { "type": "array", "items": { "type": "string" } }
          }
        },
        "boundaries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "askUser", "prohibited"],
          "properties": {
            "allowed": { "type": "array", "items": { "type": "string" } },
            "askUser": { "type": "array", "items": { "type": "string" } },
            "prohibited": { "type": "array", "items": { "type": "string" } }
          }
        },
        "unknown": { "type": "array", "items": { "type": "string" } },
        "conflicts": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
