  "actions": [
    {
      "default": "deny",
      "description": "按预期修订替换本实例的完整状态；提交后不因运行取消而撤销",
      "id": "state-write",
      "name": "更新模板状态"
    },
    {
      "default": "deny",
      "description": "处理本人授权的固定未读集合，或先读取当前账号unknown原会话并由本人API结合确认Skill判断。仅回复尚未回答且有事实依据的工作问题，含标点空格最多50字。原unknown历史保留；必要回复建立关联原来信的唯一接管预留，不通过改键反复发送。发前等待网站发送状态两个样本稳定，复验账号、消息链、预留与完整正文，点击输入框后仅按一次Enter，核对同会话新消息与送达。拒绝、客套、已回答、关键事实缺失或重要承诺不回复；已有关联预留和接管unknown不重试，原生附件及联系方式由独立动作处理。默认禁止，使用者须明确授权。",
      "id": "reply",
      "name": "发送已核对的回复"
    },
    {
      "default": "deny",
      "description": "只打开城市筛选弹层、读取真实分组与选项并选择本次配置城市；点击前回读匹配项，选择后核对实际城市。不投递、不发消息、不发送简历；配置缺失、歧义或页面变化时停止。",
      "id": "select-city",
      "name": "按用户配置选择求职城市"
    },
    {
      "default": "deny",
      "description": "仅点击本轮已复验的左侧岗位卡片并核对右侧详情、准确岗位与实际城市。只浏览详情，不触发沟通、消息或附件。来源、配置、日期或城市变化时停止；点击回执不代表匹配或发送成功。",
      "id": "select-job",
      "name": "浏览并核对候选职位详情"
    },
    {
      "default": "deny",
      "description": "仅对当前已核对账号、配置城市和准确岗位发起一次首次沟通。点击前持久预留、写出并读回账号安全索引、复验JD和立即沟通入口；来源变化、跨日或账号复验超时即停止。由网站发送使用者在App保存并批准的默认招呼，取得明确成功提示后留在本页；不补发详细介绍。每日首条实际自动消息仅作只读全文、网站消息编号、时间、送达及关联岗位核对，返回后按岗位ID核对恢复。正文截断、不符或送达未知时停止并保留记录。已沟通及confirmed/reserved/unknown不重放。不发送附件、后续回复、联系方式或重要承诺。",
      "id": "apply",
      "name": "发起已核对职位的首次沟通"
    },
    {
      "default": "deny",
      "description": "允许此入口的文件写入、网页修改和外部请求；执行范围以流程定义为准",
      "id": "workflow-write",
      "name": "执行流程写入"
    },
